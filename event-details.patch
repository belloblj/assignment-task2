+    blue: '#00A3FF', // current user volunteered
+    grey: '#8FA7B3', // event is full
+    green: '#3CDC8C', // contact buttons (call / text)
+    darkBlue: '#031A62',
+    slate: '#4D6F80',
+    text: '#5C8599',
+    title: '#4D6F80',
+    border: '#DDE3F0',
+    background: '#F2F3F5',
+    white: '#FFFFFF',
+};
